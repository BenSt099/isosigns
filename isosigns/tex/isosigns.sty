\ifthenelse{\equal{\isosignspath}{false}}
{\newcommand{\Isosignpi}[1]{/iso7001/isosigns_ISO_7001_PI_#1.pdf}}
{\newcommand{\Isosignpi}[1]{\isosignspath /iso7001/isosigns_ISO_7001_PI_#1.pdf}}

